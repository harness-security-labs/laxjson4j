# Normalize line endings on checkout so tests that compare against fixture
# files behave identically on Linux, macOS, and Windows.
* text=auto eol=lf

# Belt-and-suspenders: force LF for text fixtures and source the build
# touches directly, regardless of any user-level Git config overrides.
*.json    text eol=lf
*.java    text eol=lf
*.kt      text eol=lf
*.gradle  text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.properties text eol=lf

# Mark Windows-only scripts so they keep CRLF if anyone ever adds them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binaries — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
